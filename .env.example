# Everything is optional. With no keys the app uses free services:
#   script: Gemini free key (get one at https://aistudio.google.com/apikey)
#   voice:  edge-tts (pip install edge-tts)
#   images: Pollinations.ai (no key)
GEMINI_API_KEY=

# Paid upgrades (used automatically when set)
ANTHROPIC_API_KEY=     # better scripts
OPENAI_API_KEY=        # better images and voice

# IMAGE_PROVIDER=offline   # skip image services, use plain neon rings
PORT=3000
